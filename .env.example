# ═══════════════════════════════════════════════════════════
# Valkey AI Support Copilot — Environment Variables
# Build Beyond Limits Hackathon | Powered by Valkey
# ═══════════════════════════════════════════════════════════

# ── Valkey Connection ────────────────────────────────────────
# Use valkey/valkey-bundle:9-alpine (includes JSON, Search, Bloom, Geo)
#   docker pull valkey/valkey-bundle:9-alpine
#   docker run -d --name valkey -p 6379:6379 valkey/valkey-bundle:9-alpine
VALKEY_URL=redis://localhost:6379
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# ── Groq API (optional — enables LLM-powered resolution) ────
# Get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── API Configuration ────────────────────────────────────────
# Backend runs on port 8000, frontend on port 3000
# Frontend proxies /api/* to backend automatically via Vite
API_HOST=0.0.0.0
API_PORT=8000

# ── Tawk.to (Human Escalation Layer) ────────────────────────
# Get these from: https://dashboard.tawk.to → Administration → Chat Widget
# The embed URL format is: https://embed.tawk.to/{propertyId}/{widgetId}
VITE_TAWK_PROPERTY_ID=your_property_id_here
VITE_TAWK_WIDGET_ID=default

# Slack (optional): instant escalation alerts
SLACK_WEBHOOK_URL=

# Tuning
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.50
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Login ────────────────────────────────────────────────────
# Signs agent tokens. If empty, a random key is used and everyone is logged out on restart.
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Optional: create the first admin from here. Otherwise the first account registered in the UI becomes admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_TOKEN_TTL=28800
# AUTH_REQUIRED=false   # demo only: turns login protection off

# ── Intake (all optional) ────────────────────────────────────
# Webhook: set any long random string to enable POST /webhooks/ticket
WEBHOOK_SECRET=
# Email-to-ticket (Gmail: create an App Password, never use your real password)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_SECONDS=0
EMAIL_AUTO_REPLY=false
